# GitHub Personal Access Token (optional but recommended for higher rate limits)
GITHUB_TOKEN=your_github_token_here

# Default lookback window in days
DAYS_BACK=90
# Open AI API Key
OPENAI_API_KEY=your_openai_api_key_here
# Open AI Model
OPENAI_MODEL=gpt-4.1-mini

# Optional: Postgres connection string.
# If set, the app uses Postgres instead of SQLite.
# Example (Render internal URL): postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# SQLite path fallback (used only when DATABASE_URL is empty)
ENG_HEALTH_DB_PATH=data/eng_health.db

# Ingest tuning
INGEST_FRESHNESS_MINUTES=30
INGEST_OVERLAP_HOURS=24
